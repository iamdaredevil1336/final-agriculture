# ============================================================
#  AgriSystem — Environment Variables Template
#  Copy this to .env (local) or add to Vercel Project Settings > Environment Variables
# ============================================================

# ── Server Port (Optional, default: 3000) ───────────────────
PORT=3000

# ── Production App URL (Optional, Vercel sets VERCEL_URL automatically) ──
APP_URL=https://your-project.vercel.app

# ── AI Chatbot & Disease Diagnosis (Google Gemini) ──────────
# Get free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Government Mandi Prices API (Optional, falls back to realistic simulation) ──
# Get key: https://data.gov.in/
DATAGOV_API_KEY=your_datagov_api_key_here

# ── Voice Speech (Optional: ElevenLabs TTS) ─────────────────
# Get key: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── Email Service for Password Reset (Gmail SMTP) ───────────
# Use a 16-character Google App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM="AgriSystem <your_email@gmail.com>"